<Keyboard
    xmlns:keyboard="http://schemas.android.com/apk/res-auto"
    keyboard:keyWidth="15%p"
    keyboard:horizontalGap="0px"
    keyboard:verticalGap="0px"
    keyboard:keyHeight="@dimen/popup_key_height"
>
    <Row
        keyboard:rowEdgeFlags="top"
    >
        <Key
            keyboard:keyLabel=":-)"
            keyboard:keyOutputText=":-) "
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel=":-("
            keyboard:keyOutputText=":-( " />
        <Key
            keyboard:keyLabel=";-)"
            keyboard:keyOutputText=";-) " />
        <Key
            keyboard:keyLabel=":-P"
            keyboard:keyOutputText=":-P " />
        <Key
            keyboard:keyLabel="=-O"
            keyboard:keyOutputText="=-O "
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            keyboard:keyLabel=":-*"
            keyboard:keyOutputText=":-* "
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel=":O"
            keyboard:keyOutputText=":O " />
        <Key
            keyboard:keyLabel="B-)"
            keyboard:keyOutputText="B-) " />
        <Key
            keyboard:keyLabel=":-$"
            keyboard:keyOutputText=":-$ " />
        <Key
            keyboard:keyLabel=":-!"
            keyboard:keyOutputText=":-! "
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row
        keyboard:rowEdgeFlags="bottom"
    >
        <Key
            keyboard:keyLabel=":-["
            keyboard:keyOutputText=":-[ "
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel="O:-)"
            keyboard:keyOutputText="O:-) " />
        <Key
            keyboard:keyLabel=":-\\"
            keyboard:keyOutputText=":-\\ " />
        <Key
            keyboard:keyLabel=":'("
            keyboard:keyOutputText=":'( " />
        <Key
            keyboard:keyLabel=":-D"
            keyboard:keyOutputText=":-D "
            keyboard:keyEdgeFlags="right" />
    </Row>
</Keyboard>
