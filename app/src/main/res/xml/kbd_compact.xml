<Keyboard
    xmlns:keyboard="http://schemas.android.com/apk/res-auto"
    keyboard:keyWidth="9.09090909%p"
    keyboard:horizontalGap="0px"
    keyboard:verticalGap="0px"
    keyboard:verticalPad="@dimen/key_vertical_pad_compact"
    keyboard:layoutRows="5"
    keyboard:layoutColumns="11"
 >
    <Row keyboard:extension="true">
        <Key keyboard:codes="@integer/key_escape" keyboard:keyLabel="Esc" keyboard:isModifier="true" />
        <Key keyboard:keyLabel="`" keyboard:shiftLabel="~" />
        <Key keyboard:keyLabel="-" keyboard:shiftLabel="_" />
        <Key keyboard:keyLabel="\\" keyboard:shiftLabel="|" />
        <Key keyboard:keyLabel=";" keyboard:shiftLabel=":" />
        <Key keyboard:keyLabel="=" keyboard:shiftLabel="+" />
        <Key keyboard:keyLabel="[" keyboard:shiftLabel="{" />
        <Key keyboard:keyLabel="]" keyboard:shiftLabel="}" />
	<Key keyboard:codes="@integer/key_home" keyboard:isModifier="true" keyboard:keyLabel="Home" />
	<Key keyboard:codes="@integer/key_end" keyboard:isModifier="true" keyboard:keyLabel="End" />
	<Key keyboard:codes="@integer/key_forward_del" keyboard:isModifier="true" keyboard:keyLabel="Del" />
    </Row>

    <Row>
        <Key
            keyboard:keyLabel="1"
            keyboard:shiftLabel="!"
            keyboard:keyEdgeFlags="left"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="`"
            keyboard:keyWidth="7.09090909%p"
            />
        <Key
            keyboard:keyLabel="2"
            keyboard:shiftLabel="\@"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="~"
            />
        <Key
            keyboard:keyLabel="3"
            keyboard:shiftLabel="#"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="-"
            />
        <Key
            keyboard:keyLabel="4"
            keyboard:shiftLabel="$"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="_"
            />
        <Key
            keyboard:keyLabel="5"
            keyboard:shiftLabel="%"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="="
            />
        <Key
            keyboard:keyLabel="6"
            keyboard:shiftLabel="^"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="+"
            />
        <Key
            keyboard:keyLabel="7"
            keyboard:shiftLabel="&amp;"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="{"
            />
        <Key
            keyboard:keyLabel="8"
            keyboard:shiftLabel="*"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="}"
            />
        <Key
            keyboard:keyLabel="9"
            keyboard:shiftLabel="("
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="["
            />
        <Key
            keyboard:keyLabel="0"
            keyboard:shiftLabel=")"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="]"
            />
        <Key
            keyboard:codes="@integer/key_delete"
            keyboard:keyWidth="11.09090909%p"
            keyboard:keyIcon="@drawable/sym_keyboard_delete"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_delete"
            keyboard:isModifier="true"
            keyboard:isRepeatable="true"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            keyboard:keyLabel="q"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_q"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel="w"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_w" />
        <Key
            keyboard:keyLabel="e"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_e" />
        <Key
            keyboard:keyLabel="r"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_r" />
        <Key
            keyboard:keyLabel="t"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_t" />
        <Key
            keyboard:keyLabel="y"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_y" />
        <Key
            keyboard:keyLabel="u"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_u" />
        <Key
            keyboard:keyLabel="i"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_i" />
        <Key
            keyboard:keyLabel="o"
            keyboard:popupKeyboard="@xml/kbd_popup_narrow_template"
            keyboard:popupCharacters="@string/alternates_for_o" />
        <Key
            keyboard:keyLabel="p"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_p" />
        <Key
            keyboard:keyLabel="'"
            keyboard:shiftLabel="&quot;"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="|"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            keyboard:keyLabel="a"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_a"
            keyboard:horizontalGap="4.54545454%p"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel="s"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_s" />
        <Key
            keyboard:keyLabel="d"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_d" />
        <Key
            keyboard:keyLabel="f"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_f" />
        <Key
            keyboard:keyLabel="g"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_g" />
        <Key
            keyboard:keyLabel="h"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_h" />
        <Key
            keyboard:keyLabel="j"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_j" />
        <Key
            keyboard:keyLabel="k"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_k" />
        <Key
            keyboard:keyLabel="l"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_l" />
        <Key
            keyboard:codes="@integer/key_return"
            keyboard:keyIcon="@drawable/sym_keyboard_return"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_return"
            keyboard:isModifier="true"
            keyboard:keyWidth="13.6363636%p"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            keyboard:codes="@integer/key_shift"
            keyboard:keyWidth="11.09090909%p"
            keyboard:keyIcon="@drawable/sym_keyboard_shift"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_shift"
            keyboard:isModifier="true"
            keyboard:isSticky="true"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel="z"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_z" />
        <Key
            keyboard:keyLabel="x"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_x" />
        <Key
            keyboard:keyLabel="c"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_c" />
        <Key
            keyboard:keyLabel="v"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_v" />
        <Key
            keyboard:keyLabel="b"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_b" />
        <Key
            keyboard:keyLabel="n"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_n" />
        <Key
            keyboard:keyLabel="m"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="@string/alternates_for_m" />
        <Key
            keyboard:keyLabel=","
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters=";"
            keyboard:shiftLabel="&lt;" />
        <Key
            keyboard:keyLabel="."
            keyboard:shiftLabel="&gt;"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters=":"
            keyboard:keyIcon="@drawable/hint_popup" />
        <Key
            keyboard:codes="@integer/key_f1"
            keyboard:keyLabel="/"
            keyboard:shiftLabel="\?"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="\\"
            keyboard:keyWidth="7.09090909%p"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row keyboard:rowEdgeFlags="bottom">
        <Key
            keyboard:codes="@integer/key_fn"
            keyboard:keyLabel="Fn"
            keyboard:isModifier="true"
            keyboard:keyWidth="8.29090909%p"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel="Ctrl"
            keyboard:codes="@integer/key_ctrl_left"
            keyboard:isSticky="true"
            keyboard:keyWidth="8.29090909%p"
            keyboard:isModifier="true" />
        <Key
            keyboard:codes="@integer/key_alt_left"
            keyboard:keyLabel="Alt"
            keyboard:isSticky="true"
            keyboard:keyWidth="8.29090909%p"
            keyboard:isModifier="true" />
        <Key
            keyboard:codes="@integer/key_tab"
            keyboard:keyIcon="@drawable/sym_keyboard_tab"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_tab"
            keyboard:keyWidth="8.29090909%p"
            keyboard:popupKeyboard="@xml/popup_tab"
            keyboard:isModifier="true" />
        <Key
            keyboard:codes="@integer/key_space"
            keyboard:keyIcon="@drawable/sym_keyboard_space"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_space"
            keyboard:keyWidth="36.87272727%p"
            keyboard:isModifier="true" />
        <Key
            keyboard:codes="@integer/key_dpad_left"
            keyboard:isModifier="true"
            keyboard:isRepeatable="true"
            keyboard:isCursor="true"
            keyboard:keyWidth="7.49090909%p"
            keyboard:keyLabel="&#x25c1;" />
        <Key
            keyboard:codes="@integer/key_dpad_down"
            keyboard:isModifier="true"
            keyboard:isRepeatable="true"
            keyboard:isCursor="true"
            keyboard:keyWidth="7.49090909%p"
            keyboard:keyLabel="&#x25bd;" />
        <Key
            keyboard:codes="@integer/key_dpad_up"
            keyboard:isRepeatable="true"
            keyboard:keyLabel="&#x25b3;"
            keyboard:isCursor="true"
            keyboard:keyWidth="7.49090909%p"
            keyboard:isModifier="true" />
        <Key
            keyboard:codes="@integer/key_dpad_right"
            keyboard:isModifier="true"
            keyboard:keyLabel="&#x25b7;"
            keyboard:isRepeatable="true"
            keyboard:isCursor="true"
            keyboard:keyWidth="7.49090909%p"
            keyboard:keyEdgeFlags="right" />
    </Row>
</Keyboard>
