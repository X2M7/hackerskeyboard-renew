<Keyboard
    xmlns:keyboard="http://schemas.android.com/apk/res-auto"
    keyboard:keyWidth="26.67%p"
    keyboard:horizontalGap="0px"
    keyboard:verticalGap="@dimen/key_bottom_gap"
>
    <Row
        keyboard:rowEdgeFlags="top"
    >
        <Key
            keyboard:codes="49"
            keyboard:keyIcon="@drawable/sym_keyboard_num1"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:codes="50"
            keyboard:keyIcon="@drawable/sym_keyboard_num2" />
        <Key
            keyboard:codes="51"
            keyboard:keyIcon="@drawable/sym_keyboard_num3" />
        <Key
            keyboard:keyLabel="-"
            keyboard:keyWidth="20%p"
            keyboard:isModifier="true"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            keyboard:codes="52"
            keyboard:keyIcon="@drawable/sym_keyboard_num4"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:codes="53"
            keyboard:keyIcon="@drawable/sym_keyboard_num5" />
        <Key
            keyboard:codes="54"
            keyboard:keyIcon="@drawable/sym_keyboard_num6" />
        <Key
            keyboard:keyLabel="."
            keyboard:keyWidth="20%p"
            keyboard:isModifier="true"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            keyboard:codes="55"
            keyboard:keyIcon="@drawable/sym_keyboard_num7"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:codes="56"
            keyboard:keyIcon="@drawable/sym_keyboard_num8" />
        <Key
            keyboard:codes="57"
            keyboard:keyIcon="@drawable/sym_keyboard_num9" />
        <Key
            keyboard:codes="@integer/key_delete"
            keyboard:keyIcon="@drawable/sym_keyboard_delete"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_delete"
            keyboard:keyWidth="20%p"
            keyboard:isModifier="true"
            keyboard:isRepeatable="true"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row
        keyboard:rowEdgeFlags="bottom"
    >
        <Key
            keyboard:codes="@integer/key_symbol"
            keyboard:keyIcon="@drawable/sym_keyboard_numalt"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_numalt"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:codes="48"
            keyboard:keyIcon="@drawable/sym_keyboard_num0" />
        <Key
            keyboard:codes="@integer/key_space"
            keyboard:keyIcon="@drawable/sym_keyboard_space"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_space" />
        <Key
            keyboard:codes="@integer/key_return"
            keyboard:keyIcon="@drawable/sym_keyboard_return"
            keyboard:keyWidth="20%p"
            keyboard:isModifier="true"
            keyboard:keyEdgeFlags="right" />
    </Row>
</Keyboard>
