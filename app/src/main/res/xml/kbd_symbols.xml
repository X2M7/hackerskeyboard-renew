<Keyboard
    xmlns:keyboard="http://schemas.android.com/apk/res-auto"
    keyboard:keyWidth="10%p"
    keyboard:horizontalGap="0px"
    keyboard:verticalGap="@dimen/key_bottom_gap"
>
    <Row
        keyboard:rowEdgeFlags="top"
    >
        <Key
            keyboard:keyLabel="1"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="¹½⅓¼⅛"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel="2"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="²⅔" />
        <Key
            keyboard:keyLabel="3"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="³¾⅜" />
        <Key
            keyboard:keyLabel="4"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="⁴" />
        <Key
            keyboard:keyLabel="5"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="⅝" />
        <Key
            keyboard:keyLabel="6" />
        <Key
            keyboard:keyLabel="7"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="⅞" />
        <Key
            keyboard:keyLabel="8" />
        <Key
            keyboard:keyLabel="9" />
        <Key
            keyboard:keyLabel="0"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="ⁿ∅"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            keyboard:keyLabel="\@"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel="\#" />
        <Key
            keyboard:keyLabel="$"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="¢£€¥₣₤₱" />
        <Key
            keyboard:keyLabel="%"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="‰" />
        <Key
            keyboard:keyLabel="&amp;" />
        <Key
            keyboard:keyLabel="*"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="†‡★" />
        <Key
            keyboard:keyLabel="-"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="_–—" />
        <Key
            keyboard:keyLabel="+"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="±" />
        <Key
            keyboard:keyLabel="("
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="[{&lt;" />
        <Key
            keyboard:keyLabel=")"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="]}&gt;"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            keyboard:codes="@integer/key_shift"
            keyboard:keyLabel="@string/label_alt_key"
            keyboard:keyWidth="15%p"
            keyboard:isModifier="true"
            keyboard:isSticky="true"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel="!"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="¡" />
        <Key
            keyboard:keyLabel="&quot;"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="“”«»˝" />
        <Key
            keyboard:keyLabel="\'"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="‘’" />
        <Key
            keyboard:keyLabel=":" />
        <Key
            keyboard:keyLabel=";" />
        <Key
            keyboard:keyLabel="/" />
        <Key
            keyboard:keyLabel="\?"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="¿" />
        <Key
            keyboard:codes="@integer/key_delete"
            keyboard:keyIcon="@drawable/sym_keyboard_delete"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_delete"
            keyboard:keyWidth="15%p"
            keyboard:isModifier="true"
            keyboard:isRepeatable="true"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row
        keyboard:keyboardMode="@+id/mode_symbols"
        keyboard:rowEdgeFlags="bottom"
    >
        <Key
            keyboard:codes="@integer/key_symbol"
            keyboard:keyLabel="@string/label_alpha_key"
            keyboard:keyWidth="20%p"
            keyboard:isModifier="true"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:codes="@integer/key_f1"
            keyboard:isModifier="true" />
        <Key
            keyboard:codes="@integer/key_space"
            keyboard:keyIcon="@drawable/sym_keyboard_space"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_space"
            keyboard:keyWidth="40%p"
            keyboard:isModifier="true" />
        <Key
            keyboard:keyLabel="."
            keyboard:keyIcon="@drawable/hint_popup"
            keyboard:popupKeyboard="@xml/popup_punctuation"
            keyboard:isModifier="true" />
        <Key
            keyboard:codes="@integer/key_return"
            keyboard:keyIcon="@drawable/sym_keyboard_return"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_return"
            keyboard:keyWidth="20%p"
            keyboard:isModifier="true"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row
        keyboard:keyboardMode="@+id/mode_symbols_with_settings_key"
        keyboard:rowEdgeFlags="bottom"
    >
        <Key
            keyboard:codes="@integer/key_symbol"
            keyboard:keyLabel="@string/label_alpha_key"
            keyboard:keyWidth="15%p"
            keyboard:isModifier="true"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:codes="@integer/key_settings"
            keyboard:keyIcon="@drawable/sym_keyboard_settings"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_settings"
            keyboard:isModifier="true" />
        <Key
            keyboard:codes="@integer/key_f1"
            keyboard:isModifier="true" />
        <Key
            keyboard:codes="@integer/key_space"
            keyboard:keyIcon="@drawable/sym_keyboard_space"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_space"
            keyboard:keyWidth="30%p"
            keyboard:isModifier="true" />
        <Key
            keyboard:keyLabel="."
            keyboard:keyIcon="@drawable/hint_popup"
            keyboard:popupKeyboard="@xml/popup_punctuation"
            keyboard:isModifier="true" />
        <Key
            keyboard:codes="@integer/key_return"
            keyboard:keyIcon="@drawable/sym_keyboard_return"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_return"
            keyboard:keyWidth="25%p"
            keyboard:isModifier="true"
            keyboard:keyEdgeFlags="right" />
    </Row>
</Keyboard>
