            keyboard:keyWidth="13.64%p"
            keyboard:isModifier="true"
            keyboard:isRepeatable="true"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row
        keyboard:keyboardMode="@+id/mode_normal"
        keyboard:keyWidth="10%p"
        keyboard:rowEdgeFlags="bottom"
    >
        <Key
            keyboard:codes="@integer/key_symbol"
            keyboard:keyLabel="@string/label_symbol_key"
            keyboard:keyWidth="20%p"
            keyboard:isModifier="true"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:codes="@integer/key_f1"
            keyboard:isModifier="true" />
        <Key
            keyboard:codes="@integer/key_space"
            keyboard:keyIcon="@drawable/sym_keyboard_space"
            keyboard:iconPreview="@drawable/sym_keyboard_feedback_space"
            keyboard:keyWidth="40%p"
            keyboard:isModifier="true" />
        <Key
            keyboard:keyLabel="."
            keyboard:keyIcon="@drawable/hint_popup"
            keyboard:popupKeyboard="@xml/popup_punctuation"
            keyboard:isModifier="true" />
        <Key
