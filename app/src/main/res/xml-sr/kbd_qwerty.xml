            keyboard:isModifier="true"
            keyboard:isSticky="true"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel="ж" />
        <Key
            keyboard:keyLabel="џ" />
        <Key
            keyboard:keyLabel="ц" />
        <Key
            keyboard:keyLabel="в" />
