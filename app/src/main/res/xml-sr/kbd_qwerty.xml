        keyboard:rowEdgeFlags="top"
    >
        <Key
            keyboard:keyLabel="љ"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="1"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel="њ"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="2" />
        <Key
            keyboard:keyLabel="е"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="3" />
        <Key
            keyboard:keyLabel="р"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="4" />
        <Key
            keyboard:keyLabel="т"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="5" />
        <Key
            keyboard:keyLabel="з"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="6" />
        <Key
            keyboard:keyLabel="у"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="7" />
        <Key
            keyboard:keyLabel="и"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="8" />
        <Key
            keyboard:keyLabel="о"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="9" />
        <Key
            keyboard:keyLabel="п"
            keyboard:popupKeyboard="@xml/kbd_popup_template"
            keyboard:popupCharacters="0" />
        <Key
            keyboard:keyLabel="ш"
            keyboard:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            keyboard:keyLabel="а"
            keyboard:keyEdgeFlags="left" />
        <Key
            keyboard:keyLabel="с" />
        <Key
            keyboard:keyLabel="д" />
        <Key
            keyboard:keyLabel="ф" />
        <Key
            keyboard:keyLabel="г" />
        <Key
            keyboard:keyLabel="х" />
        <Key
            keyboard:keyLabel="ј" />
        <Key
            keyboard:keyLabel="к" />
        <Key
            keyboard:keyLabel="л" />
        <Key
            keyboard:keyLabel="ч" />
        <Key
            keyboard:keyLabel="ћ"
            keyboard:keyEdgeFlags="right" />
