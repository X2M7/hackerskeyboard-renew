    <Row keyboard:extension="true">
        <Key keyboard:keyLabel="1" keyboard:shiftLabel="!" />
        <Key keyboard:keyLabel="2" keyboard:shiftLabel="\@" />
        <Key keyboard:keyLabel="3" keyboard:shiftLabel="\#" />
        <Key keyboard:keyLabel="4" keyboard:shiftLabel="&amp;" />
        <Key keyboard:keyLabel="5" keyboard:shiftLabel="-" />
        <Key keyboard:keyLabel="6" keyboard:shiftLabel="\'" />
        <Key keyboard:keyLabel="7" keyboard:shiftLabel=":" />
        <Key keyboard:keyLabel="8" keyboard:shiftLabel="&quot;" />
        <Key keyboard:keyLabel="9" keyboard:shiftLabel="/" />
        <Key keyboard:keyLabel="0" keyboard:shiftLabel="\?" />
    </Row>    
    <Row>
